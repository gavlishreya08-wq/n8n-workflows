        "messages": {
          "values": [
            {
              "content": "=Based on the candidate metadata provided in {{ $json[\"text\"] }}, RETURN ONLY a CSV (no explanations, no backticks, no JSON, no extra text). \n\nUse this header (exact order):\nCategory,Difficulty,Question,Answer\n\nRules:\n- Categories: \"Generic Questions\", \"Technology Questions\", \"Coding Exercise\"\n- Each category must have exactly 5 questions (3 easy, 2 difficult)\n- Difficulty must be either \"easy\" or \"difficult\"\n- All questions must be **relevant to the candidate's background** in the provided metadata\n- Answer must contain a short, correct sample answer (not blank)\n- For text fields that contain commas, enclose the entire field in double quotes (\")\n- Escape any double quote in a field by doubling it (\"\")\n- Output exactly one header line, then 15 data rows (5 per category)\n- Output only the CSV text, nothing else\n"
            }
          ]
        },
